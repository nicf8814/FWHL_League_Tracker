{
  "name": "fwhl-league-tracker",
  "private": true,
  "version": "2.0.0",
  "description": "Trade analyzer, trade finder and standings for the Favre's Waffle House fantasy league. Runs fully in the browser.",
  "homepage": "https://nicf8814.github.io/FWHL_League_Tracker/",
  "repository": "github:nicf8814/FWHL_League_Tracker",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/engine/engine.test.ts src/engine/tracker.test.ts scripts/updates.test.ts",
    "data": "node scripts/data.ts",
    "data:check": "node scripts/data.ts check"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.7"
  }
}
